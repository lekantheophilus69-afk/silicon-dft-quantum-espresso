&CONTROL
    calculation = 'scf',
    prefix = 'silicon',
    pseudo_dir = '/usr/share/espresso/pseudo',
    outdir = './tmp/'
/
&SYSTEM
    ibrav = 2,
    celldm(1) = 10.50,
    nat = 2,
    ntyp = 1,
    ecutwfc = 50.0,
    ecutrho = 400.0,
/

&ELECTRONS 
     conv_thr = 1.0d-8
/
ATOMIC_SPECIES
     Si 28.0855 Si.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
Si 0.00 0.00 0.00
Si 0.25 0.25 0.25

K_POINTS automatic
8 8 8 0 0 0
